# ============================================================
# Piwigo — DevTools Configuration
# ============================================================

# ============================================================
# PROJECT IDENTIFICATION
# ============================================================
# PROJECT_TYPE : piwigo = Piwigo core, plugin = Plugin Piwigo
# Auto-detected si absent (cherche admin/admin.php dans PROJECT_ROOT)
PROJECT_TYPE=piwigo
PROJECT_NAME=Piwigo
EASYPHP_PIWIGO_INSTANCE=piwigo-test

# --- Racines des chemins ---
PROJECT_ROOT=D:\Gotcha\Documents\DIY\GitHub\Piwigo\Piwigo\Piwigo
EASYPHP_WWW_DIR=C:\EasyPHP\eds-www

# --- O2Switch (Production) — Base de données ---
O2_SSH_HOST=titan.o2switch.net
O2_SSH_USER=gotcha
O2_DB_USER=gotcha_piwigo
O2_DB_PASS=sKx&053#Yl@Cws05
O2_DB_NAME=gotcha_piwigo

# --- EasyPHP (Local) — Base de données ---
LOCAL_DB_USER=gotcha_piwigo
LOCAL_DB_PASS=sKx&053#Yl@Cws05
LOCAL_DB_NAME=gotcha_piwigo
LOCAL_MYSQL_BIN=C:\EasyPHP\eds-binaries\dbserver\mysql8020x64\bin\mysql.exe
# Dossier de stockage des dumps
LOCAL_DUMP_DIR=C:\EasyPHP\eds-www\import_db
# Tables dumpées schéma seul (sans données), séparées par des virgules
EXCLUDE_DATA_TABLES=piwigo_history,piwigo_search

# ============================================================
# DEPLOY LOCAL (EasyPHP)
# ============================================================
# Chemin source et destination (déduits automatiquement si absent)
# Pour plugin :     DEPLOY_SRC=D:\...\MonPlugin
#                   DEPLOY_DST=C:\EasyPHP\eds-www\piwigo-test\plugins\MonPlugin
# Pour Piwigo core :  DEPLOY_SRC=PROJECT_ROOT
#                   DEPLOY_DST=C:\EasyPHP\eds-www\piwigo-test
# Optionnel si bien configuré ci-dessus
# DEPLOY_SRC=D:\Gotcha\Documents\DIY\GitHub\Piwigo\Piwigo\Piwigo
# DEPLOY_DST=C:\EasyPHP\eds-www\piwigo-test

# Build npm
# HAS_NPM_BUILD : auto-detect si absent (vérifie package.json)
# NPM_SCRIPT : nom du script npm à lancer (défaut: minify)
NPM_SCRIPT=minify

# --- Deploy Remote — Serveur prod ---
REMOTE_USER=gotcha
REMOTE_HOST=ftp.julien-moreau.fr
REMOTE_DIR=/home/gotcha/galerie.julien-moreau.fr
SSH_KEY=C:\Users\Gotcha\.ssh\PC-FIXE-to-o2switch
# MSYS2_BASH : détection automatique si absent (C:\tools\msys64 ou C:\msys64)
# MSYS2_BASH=C:\tools\msys64\usr\bin\bash.exe
# Fichiers trackés git mais exclus du déploiement remote
DEPLOY_EXCLUDES=CLAUDE.md,claude.md,local/,package.json,package-lock.json
