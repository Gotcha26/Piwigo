+}
+
+@keyframes menubar-name-scroll {
+  0%   { transform: translateX(0); }
+  10%  { transform: translateX(0); }
+  60%  { transform: translateX(var(--scroll-dist, 0px)); }
+  100% { transform: translateX(var(--scroll-dist, 0px)); }
+}
+
+/* Wrap mode: clip expands to allow wrapping */
+#menubar-plugins dd li a.name-wrap .menubar-name-clip {
+  overflow: visible;
+  max-width: 154px;
+}
+
+#menubar-plugins dd li a.name-wrap .menubar-name {
