# ============================================================
# Piwigo DevTools — Configuration Example
# ============================================================
# Copy this file to .env.db and fill in your specific values
# This configuration works for both Piwigo core and plugins
#
# For Piwigo core: Set PROJECT_TYPE=piwigo
# For plugins:     Set PROJECT_TYPE=plugin
#
# Auto-detection: If PROJECT_TYPE is absent, the script checks
# for admin/admin.php to determine if this is core or a plugin.

# ============================================================
# PROJECT IDENTIFICATION
# ============================================================
# PROJECT_TYPE: "piwigo" for core, "plugin" for Piwigo plugins
# Auto-detected if absent (checks for admin/admin.php)
PROJECT_TYPE=piwigo

# PROJECT_NAME: Used in menu titles and configuration display
PROJECT_NAME=Piwigo

# EASYPHP_PIWIGO_INSTANCE: Name of the Piwigo instance folder
# (e.g., "piwigo-test" → C:\EasyPHP\eds-www\piwigo-test)
EASYPHP_PIWIGO_INSTANCE=piwigo-test

# --- Project Root Paths ---
PROJECT_ROOT=D:\Gotcha\Documents\DIY\GitHub\Piwigo\Piwigo\Piwigo
EASYPHP_WWW_DIR=C:\EasyPHP\eds-www

# ============================================================
# REMOTE DATABASE (O2Switch / Production)
# ============================================================
O2_SSH_HOST=titan.o2switch.net
O2_SSH_USER=gotcha
O2_DB_USER=gotcha_piwigo
O2_DB_PASS=your_password_here
O2_DB_NAME=gotcha_piwigo

# ============================================================
# LOCAL DATABASE (EasyPHP)
# ============================================================
LOCAL_DB_USER=gotcha_piwigo
LOCAL_DB_PASS=your_password_here
LOCAL_DB_NAME=gotcha_piwigo
LOCAL_MYSQL_BIN=C:\EasyPHP\eds-binaries\dbserver\mysql8020x64\bin\mysql.exe

# Directory where database dumps are stored for import/export
LOCAL_DUMP_DIR=C:\EasyPHP\eds-www\import_db

# Tables to dump with schema only (no data), comma-separated
# These tables are excluded from data export but schema is kept
EXCLUDE_DATA_TABLES=piwigo_history,piwigo_search

# ============================================================
# DEPLOY LOCAL (EasyPHP)
# ============================================================
# DEPLOY_SRC / DEPLOY_DST: Auto-configured if absent
#
# For Piwigo core:
#   DEPLOY_SRC = PROJECT_ROOT
#   DEPLOY_DST = C:\EasyPHP\eds-www\piwigo-test
#
# For plugins:
#   DEPLOY_SRC = PROJECT_ROOT
#   DEPLOY_DST = C:\EasyPHP\eds-www\piwigo-test\plugins\PluginName
#
# Optional: Override auto-detection
# DEPLOY_SRC=D:\Gotcha\Documents\DIY\GitHub\Piwigo\Piwigo\Piwigo
# DEPLOY_DST=C:\EasyPHP\eds-www\piwigo-test

# Build configuration
# NPM_SCRIPT: Name of npm script to run (default: minify)
# Auto-detects if package.json exists in PROJECT_ROOT
NPM_SCRIPT=minify

# ============================================================
# DEPLOY REMOTE (Production Server)
# ============================================================
# Note: Remote deploy is only available for plugins, not for Piwigo core
REMOTE_USER=gotcha
REMOTE_HOST=ftp.example.com
REMOTE_DIR=/path/to/piwigo/plugins/PluginName
SSH_KEY=C:\Users\Gotcha\.ssh\id_ed25519

# MSYS2_BASH: Path to MSYS2 bash (for rsync on Windows)
# Auto-detected if absent (searches C:\tools\msys64 or C:\msys64)
# MSYS2_BASH=C:\tools\msys64\usr\bin\bash.exe

# Files to exclude from remote deploy
# (in addition to those in .gitignore)
DEPLOY_EXCLUDES=CLAUDE.md,claude.md,local/,package.json,package-lock.json
