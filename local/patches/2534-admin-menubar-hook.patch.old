diff --git a/admin/themes/default/theme.css b/admin/themes/default/theme.css
index 4c91d03a7..0af8fb568 100644
--- a/admin/themes/default/theme.css
+++ b/admin/themes/default/theme.css
@@ -2175,2 +2175,78 @@ a.admin-main:hover {color:#fff;}
   margin-top: 2px;
+  transition: transform 0.25s ease;
+  transform: rotate(0deg);
+}
+
+#menubar dl.is-open > dt i.open-menu {
+  transform: rotate(-180deg);
+}
+
+#menubar .menubar-separator { padding: 0 20px; }
+#menubar .menubar-separator hr { border: none; border-top: 1px solid #555; margin: 4px 0; }
+
+#menubar dt a.dt-label { display:inline; }
+
+/* Plugin menubar name display modes */
+#menubar-plugins dd li a {
+  display: flex;
+  align-items: center;
+}
+
+/* Clipping container: sits right after the icon, clips the scrolling text */
+#menubar-plugins dd li a .menubar-name-clip {
+  display: inline-block;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  width: 154px;
+  vertical-align: middle;
+}
+
+/* On hover: remove ellipsis and enable transform for scroll animation */
+#menubar-plugins dd li a:hover .menubar-name-clip {
+  text-overflow: clip;
+}
+
+#menubar-plugins dd li a:hover .menubar-name {
+  display: inline-block;
+}
+
+/* The scrolling text element */
+#menubar-plugins dd li a .menubar-name {
+  display: inline;
+  white-space: nowrap;
+}
+
+/* Scroll on hover for overflowing names only */
+#menubar-plugins dd li a:hover .menubar-name.name-overflow {
+  animation: menubar-name-scroll var(--scroll-duration, 3s) linear infinite;
+}
+
+@keyframes menubar-name-scroll {
+  0%   { transform: translateX(0); }
+  10%  { transform: translateX(0); }
+  60%  { transform: translateX(var(--scroll-dist, 0px)); }
+  100% { transform: translateX(var(--scroll-dist, 0px)); }
+}
+
+/* Wrap mode: clip expands to allow wrapping */
+#menubar-plugins dd li a.name-wrap .menubar-name-clip {
+  overflow: visible;
+  max-width: 154px;
+}
+
+#menubar-plugins dd li a.name-wrap .menubar-name {
+  white-space: normal;
+  word-break: break-word;
+  line-height: 1.3;
+}
+
+#pluginMenubarForm {
+  padding-bottom: 50px;
+}
+
+#menubar-plugins dd li a .menubar-icon-placeholder {
+  display: inline-block;
+  width: 1em;
+  margin-right: 0.3em;
 }
