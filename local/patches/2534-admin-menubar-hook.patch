From 4bab885c1b0061957bb7d8d0143380a7d9a58033 Mon Sep 17 00:00:00 2001
From: Gotcha26 <spambiengentil@gmail.com>
Date: Wed, 1 Apr 2026 11:36:17 +0200
Subject: [PATCH] Fix #2534: Prevent duplicate plugin menubar entries and add
 scrolling

- Add PLUGIN_DIR field support to detect hook-registered plugins during fallback deduplication
- Add scroll container (class="scroll") to plugin list for proper overflow handling
- Fallback now checks: ID match, plugin folder match, and PLUGIN_DIR match

Fixes:
1. Duplicate entries when plugin uses hook with custom ID != folder name
2. Page overflow when plugin list exceeds viewport height

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 admin/include/functions.php             | 14 ++++++++++----
 admin/themes/default/template/admin.tpl |  2 +-
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/admin/include/functions.php b/admin/include/functions.php
index 15976ef62..94360a917 100644
--- a/admin/include/functions.php
+++ b/admin/include/functions.php
@@ -2837,14 +2837,19 @@ function get_admin_menubar_plugin_links()
     return $items;
   }
 
-  // Collect IDs already registered via the hook
+  // Collect IDs and plugin dirs already registered via the hook
   $registered_ids = array();
+  $registered_dirs = array();
   foreach ($items as $item)
   {
     if (isset($item['ID']))
     {
       $registered_ids[] = $item['ID'];
     }
+    if (isset($item['PLUGIN_DIR']))
+    {
+      $registered_dirs[] = $item['PLUGIN_DIR'];
+    }
   }
 
   include_once(PHPWG_ROOT_PATH.'admin/include/plugins.class.php');
@@ -2873,9 +2878,10 @@ function get_admin_menubar_plugin_links()
       $fallback_id = 'fallback_' . $plugin_id;
     }
 
-    // Skip if already registered (either via hook with same ID, or already
-    // computed as a fallback_* id — prevents duplicates on repeated calls)
-    if (in_array($fallback_id, $registered_ids) || in_array($plugin_id, $registered_ids))
+    // Skip if already registered via hook (by ID, PLUGIN_DIR, or fallback ID)
+    if (in_array($fallback_id, $registered_ids)
+      || in_array($plugin_id, $registered_ids)
+      || in_array($plugin_id, $registered_dirs))
     {
       continue;
     }
diff --git a/admin/themes/default/template/admin.tpl b/admin/themes/default/template/admin.tpl
index eea349a80..070f370e7 100644
--- a/admin/themes/default/template/admin.tpl
+++ b/admin/themes/default/template/admin.tpl
@@ -166,7 +166,7 @@ jQuery(document).ready(function() {
     </dt>
     {if $PLUGINS_MENU_ITEMS|@count > 0}
     <dd>
-      <ul>
+      <ul class="scroll">
         {foreach from=$PLUGINS_MENU_ITEMS item=item}
         {if isset($item.TYPE) && $item.TYPE == 'separator'}
         <li class="menubar-separator"><hr></li>
-- 
